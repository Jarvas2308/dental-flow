# Variáveis `VITE_` são inlinadas no bundle pelo Vite durante o build e ficam
# visíveis no cliente. Só coloque aqui valores publicáveis.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Opcional: usada apenas como fallback do issuer OAuth do MCP quando
# VITE_SUPABASE_URL não está definida (ver src/lib/mcp/index.ts).
VITE_SUPABASE_PROJECT_ID=""

# Variáveis sem prefixo só existem no runtime do servidor. As duas abaixo
# repetem os valores publicáveis acima; o código cai no equivalente `VITE_`
# quando elas faltam.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PROJECT_ID=""
